# ==============================================================================
# Handcrafted Multi-Vendor Marketplace - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env OR APP-SPECIFIC .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT ACTUAL SECRETS OR PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Backend API Service Configuration (apps/api)
# ------------------------------------------------------------------------------
# Port for the NestJS REST API service
PORT=4000
API_PREFIX=api/v1

# Primary PostgreSQL Database Connection (ACID source of truth)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://marketplace_user:replace_with_local_password@localhost:5432/marketplace_dev

# Redis Connection (Caches, BullMQ Queues, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Cryptographic & Authentication Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_cookie_signing_secret_min_32_chars

# CORS Allowed Client Origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# S3-Compatible Object Storage (MinIO local / AWS S3 / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_s3_access_key
S3_SECRET_KEY=replace_with_s3_secret_key
S3_PUBLIC_BUCKET=marketplace-public-media
S3_PRIVATE_BUCKET=marketplace-private-kyc-documents
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 3. Customer Web Storefront Configuration (apps/storefront)
# ------------------------------------------------------------------------------
PORT_STOREFRONT=3000
# Browser-exposed URL to backend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Artisan Handmade Marketplace"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Seller Operations Portal Configuration (apps/seller-portal)
# ------------------------------------------------------------------------------
PORT_SELLER_PORTAL=3001
NEXT_PUBLIC_SELLER_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SELLER_APP_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 5. Administrative Control Centre Configuration (apps/admin-portal)
# ------------------------------------------------------------------------------
PORT_ADMIN_PORTAL=3002
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002

# ------------------------------------------------------------------------------
# 6. Future External Providers (Placeholders for Future Gates G08 / G11)
# ------------------------------------------------------------------------------
# PAYMENT_GATEWAY_KEY=placeholder_for_g08
# PAYMENT_WEBHOOK_SECRET=placeholder_for_g08
# COURIER_API_KEY=placeholder_for_g11
